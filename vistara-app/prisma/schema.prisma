generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  HOST
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  INACTIVE
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  HOTEL
  GUEST_HOUSE
  RESORT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING
  PAYMENT
  VERIFICATION
  PROPERTY
  EXPLORE
  SYSTEM
}

enum ActivityType {
  LOGIN
  LOGOUT
  BOOKING
  CANCELLATION
  PROPERTY_CREATED
  PROPERTY_UPDATED
  VERIFICATION_SUBMITTED
  PROFILE_UPDATED
  WISHLIST_ADDED
  WISHLIST_REMOVED
  EXPLORE_SAVED
  EXPLORE_REVIEWED
}

enum ExploreType {
  PLACE
  RESTAURANT
  EXPERIENCE
  LOCAL_GUIDE
}

enum ExploreStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GuideType {
  CITY_GUIDE
  LOCAL_TIP
  TRAVEL_GUIDE
  FOOD_GUIDE
  SAFETY_GUIDE
  CULTURE_GUIDE
}

enum VerificationLevel {
  UNVERIFIED
  VISTARA_VERIFIED
  COMMUNITY_VERIFIED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  role      UserRole @default(GUEST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        Profile?
  properties     Property[]             @relation("HostProperties")
  bookings       Booking[]              @relation("GuestBookings")
  reviews        Review[]
  wishlists      Wishlist[]
  notifications  Notification[]
  activities     AccountActivity[]
  verifications  PropertyVerification[]
  exploreReviews ExploreReview[]
  exploreSaves   ExploreSave[]
  localGuides    LocalGuide[]           @relation("GuideAuthor")
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  firstName String?
  lastName  String?
  bio       String?
  city      String?
  country   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id            Int            @id @default(autoincrement())
  hostId        Int
  title         String
  description   String
  type          PropertyType
  status        PropertyStatus @default(DRAFT)
  address       String
  city          String
  country       String
  guests        Int
  bedrooms      Int
  bathrooms     Int
  pricePerNight Decimal        @db.Decimal(10, 2)
  rating        Float          @default(0)
  reviewCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  host         User                  @relation("HostProperties", fields: [hostId], references: [id])
  images       PropertyImage[]
  amenities    PropertyAmenity[]
  verification PropertyVerification?
  bookings     Booking[]
  reviews      Review[]
  wishlists    Wishlist[]
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  url        String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId Int
  amenityId  Int

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyVerification {
  id                  Int                @id @default(autoincrement())
  propertyId          Int                @unique
  userId              Int
  identityStatus      VerificationStatus @default(PENDING)
  ownershipStatus     VerificationStatus @default(PENDING)
  certificateStatus   VerificationStatus @default(PENDING)
  identityDocument    String?
  ownershipDocument   String?
  certificateDocument String?
  notes               String?
  submittedAt         DateTime?
  verifiedAt          DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model Booking {
  id            Int           @id @default(autoincrement())
  guestId       Int
  propertyId    Int
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  nights        Int
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  guest    User     @relation("GuestBookings", fields: [guestId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  review   Review?
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  bookingId  Int      @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountActivity {
  id          Int          @id @default(autoincrement())
  userId      Int
  type        ActivityType
  description String?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExploreItem {
  id                Int               @id @default(autoincrement())
  title             String
  slug              String            @unique
  description       String
  type              ExploreType
  status            ExploreStatus     @default(DRAFT)
  address           String?
  city              String
  state             String?
  country           String
  latitude          Decimal?          @db.Decimal(10, 7)
  longitude         Decimal?          @db.Decimal(10, 7)
  coverImage        String?
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  verificationLevel VerificationLevel @default(UNVERIFIED)
  isHiddenGem       Boolean           @default(false)
  isFeatured        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  images     ExploreImage[]
  categories ExploreCategoryItem[]
  reviews    ExploreReview[]
  guides     LocalGuide[]
  saves      ExploreSave[]
  restaurant Restaurant?
  experience Experience?
}

model ExploreImage {
  id        Int      @id @default(autoincrement())
  exploreId Int
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  explore ExploreItem @relation(fields: [exploreId], references: [id], onDelete: Cascade)
}

model ExploreCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  icon        String?

  items ExploreCategoryItem[]
}

model ExploreCategoryItem {
  exploreId  Int
  categoryId Int

  explore  ExploreItem     @relation(fields: [exploreId], references: [id], onDelete: Cascade)
  category ExploreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([exploreId, categoryId])
}

model Restaurant {
  id             Int     @id @default(autoincrement())
  exploreId      Int     @unique
  cuisine        String?
  priceRange     String?
  phone          String?
  website        String?
  reservationUrl String?
  openingHours   Json?
  vegetarian     Boolean @default(false)
  familyFriendly Boolean @default(false)

  explore ExploreItem @relation(fields: [exploreId], references: [id], onDelete: Cascade)
}

model Experience {
  id              Int      @id @default(autoincrement())
  exploreId       Int      @unique
  durationMinutes Int?
  price           Decimal? @db.Decimal(10, 2)
  maxGuests       Int?
  meetingPoint    String?
  bookingUrl      String?

  explore ExploreItem @relation(fields: [exploreId], references: [id], onDelete: Cascade)
}

model LocalGuide {
  id          Int       @id @default(autoincrement())
  exploreId   Int?
  authorId    Int?
  title       String
  slug        String    @unique
  content     String
  type        GuideType
  city        String
  state       String?
  country     String?
  coverImage  String?
  authorName  String?
  authorImage String?
  isVerified  Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  explore ExploreItem? @relation(fields: [exploreId], references: [id], onDelete: SetNull)
  author  User?        @relation("GuideAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model ExploreReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  exploreId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  explore ExploreItem @relation(fields: [exploreId], references: [id], onDelete: Cascade)

  @@unique([userId, exploreId])
}

model ExploreSave {
  id        Int      @id @default(autoincrement())
  userId    Int
  exploreId Int
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  explore ExploreItem @relation(fields: [exploreId], references: [id], onDelete: Cascade)

  @@unique([userId, exploreId])
}
